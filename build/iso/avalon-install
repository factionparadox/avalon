#!/bin/bash
# avalon-install: Avalon's installer. It starts by itself when the stick boots (the first console,
# in large type) as dialog screens. It asks: your username, your password, root's password, which
# disk (from a list), whether to erase it (yes/no). Then, with no internet and nothing compiled:
#   1. the disk: 1 GiB EFI and Btrfs, with the system in @, your files in @home, logs in @log and
#      snapshots in @snapshots (going back to a snapshot never touches your files or logs)
#   2. the system: everything on the stick but its live session, copied across (rsync)
#   3. your settings: fstab, the name, London time, British English and keyboard, you, the login
#      screen (greetd with the Garden's), the services, and GRUB with Avalon's boot menu
# What it ran, with its output, is kept in /var/log/avalon-install.log on the new system.
#
# To start it again: log in as root on the stick and type  avalon-install
TITLE="Avalon 1 (Iskra) · installer"
LOG=/tmp/avalon-install.log
T=/mnt/avalon-target                # the new system, while installing
SRC=/mnt/liveslakfs                 # liveslak's view of the system without the live session
EFI_GIB=1
MIN_GIB=24
GiB=$((1024 * 1024 * 1024))
BTRFS_OPTS=compress=zstd:1,noatime

d() { dialog --backtitle "$TITLE" --colors "$@" 3>&1 1>&2 2>&3; }   # the answer on stdout
quit() { clear; echo "$*"; echo "To start again:  avalon-install"; exit 1; }
log() { printf '%s\n' "$*" >> "$LOG"; }
part() { case $1 in *[0-9]) echo "${1}p$2" ;; *) echo "$1$2" ;; esac; }   # nvme0n1 -> nvme0n1p1
uuid() { blkid -s UUID -o value "$1"; }
partuuid() { blkid -s PARTUUID -o value "$1"; }
inroot() { chroot "$T" /usr/bin/env -i HOME=/root TERM=linux LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin "$@"; }

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
setfont latarcyrheb-sun32 2>/dev/null
: > "$LOG"
[ -d /sys/firmware/efi ] || quit "This laptop started the stick in legacy BIOS mode. Avalon installs for UEFI only:
restart, and pick the stick's UEFI entry in the boot menu."
[ -d "$SRC/usr/share/avalon" ] || quit "This doesn't look like Avalon's stick ($SRC has no Avalon in it)."

d --title " Avalon " --msgbox "\n\
Pasha keeps the garden.\n\n\
This puts \Zb\Z6Avalon\Zn on this laptop: Slackware, with the Garden System on top.\n\n\
Five questions, then it copies itself across: no internet needed, nothing compiled, a few \
minutes. Wi-Fi is set up once you're in the Garden.\n\n\
\Z3Up/Down\Zn choose · \Z3Tab\Zn moves between buttons · \Z3Enter\Zn confirms · \Z3Esc\Zn backs out" 17 78 \
	|| quit "Stopped; nothing was touched."

# --- the questions ------------------------------------------------------------------------

while :; do
	USER_NAME=$(d --title " You " --inputbox "\nThe username you'll log in with (small letters, no spaces):" 10 64 "${USER_NAME:-}") \
		|| quit "Stopped; nothing was touched."
	[[ $USER_NAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [[ ! $USER_NAME =~ ^(root|live|greeter)$ ]] && break
	d --title " You " --msgbox "\n\"$USER_NAME\" won't do: small letters, numbers, - and _, starting with a letter." 9 64
done

pw() {   # ask twice until both match; the password on stdout. $2: an optional note under the question
	local who=$1 note=${2:+\n$2} a b
	while :; do
		a=$(d --title " $who " --insecure --passwordbox "\nChoose a password for $who:$note" 11 64) || return 1
		b=$(d --title " $who " --insecure --passwordbox "\nOnce more, to be sure:" 10 64) || return 1
		[ -n "$a" ] && [ "$a" = "$b" ] && { printf '%s' "$a"; return 0; }
		d --title " $who " --msgbox "\nThose didn't match (or were empty). Again." 8 50
	done
}
USER_PW=$(pw "$USER_NAME") || quit "Stopped; nothing was touched."
ROOT_PW=$(pw root "(the administrator; day to day you use sudo)") || quit "Stopped; nothing was touched."

disk_info() {   # "953.9 GB  WD_BLACK SN850X" for a disk name, from /sys
	local b=/sys/block/$1 sectors model
	sectors=$(cat "$b/size" 2>/dev/null || echo 0)
	model=$(cat "$b/device/model" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//')
	awk -v s="$sectors" -v m="${model:-disk}" 'BEGIN { printf "%.1f GB  %s", s * 512 / 1e9, m }'
}
# the disks, straight from the kernel (/sys/block), without the stick we're running from
stick=$(findmnt -no SOURCE /mnt/livemedia 2>/dev/null)
stick=${stick##*/}
[ -n "$stick" ] && [ -e "/sys/class/block/$stick/partition" ] && stick=$(basename "$(dirname "$(readlink -f "/sys/class/block/$stick")")")
menu=()
for dev in /sys/block/*; do
	name=${dev##*/}
	case $name in loop*|ram*|zram*|sr*|fd*|md*|dm-*|nbd*) continue ;; esac
	[ "$name" = "$stick" ] && continue
	[ "$(cat "$dev/size" 2>/dev/null || echo 0)" -ge $(( (EFI_GIB + MIN_GIB) * GiB / 512 )) ] || continue
	menu+=("$name" "$(disk_info "$name")")
done
menu+=("other" "type a disk's name myself")
DISK=$(d --title " The disk " --menu "\nInstall Avalon on which disk?" 15 74 6 "${menu[@]}") \
	|| quit "Stopped; nothing was touched."
if [ "$DISK" = other ]; then
	DISK=$(d --title " The disk " --inputbox "\nWhat the kernel sees:\n\n$(ls /sys/block | tr '\n' ' ')\n\nThe stick: ${stick:-not found}\n\nWhich disk (e.g. nvme0n1)?" 16 74) \
		|| quit "Stopped; nothing was touched."
	DISK=${DISK#/dev/}
	[ -b "/dev/$DISK" ] || quit "There's no disk called /dev/$DISK."
fi
d --title " Erase it? " --defaultno --yes-label "Erase and install" --no-label "Stop" --yesno "\n\
\Zb\Z1Everything on $DISK will be erased.\Zn\n\n\
  $(disk_info "$DISK")\n\n\
  1 GiB EFI, the rest Btrfs (with snapshots)\n\
  you: $USER_NAME · London time · British English and keyboard\n\n\
Erase it and install Avalon?" 16 70 || quit "Stopped; nothing was touched."
DEV=/dev/$DISK

# --- the work ------------------------------------------------------------------------------

steps() {
	set -eo pipefail
	echo "==> 1. The disk: $DEV, 1 GiB EFI and Btrfs"
	EFI=$(part "$DEV" 1); ROOT=$(part "$DEV" 2)
	wipefs -a "$DEV"
	printf 'label: gpt\nsize=%sGiB, type=uefi, name=EFI\ntype=linux, name=Avalon\n' "$EFI_GIB" | sfdisk --wipe always "$DEV"
	partprobe "$DEV" 2>/dev/null || true; udevadm settle 2>/dev/null || true; sleep 2
	mkfs.fat -F 32 -n EFI "$EFI"
	mkfs.btrfs -q -f -L Avalon "$ROOT"
	mkdir -p "$T"; mount "$ROOT" "$T"
	for sv in @ @home @log @snapshots; do btrfs subvolume create "$T/$sv" >/dev/null; done
	umount "$T"
	mount -o "subvol=@,$BTRFS_OPTS" "$ROOT" "$T"
	mkdir -p "$T/home" "$T/var/log" "$T/.snapshots" "$T/boot/efi"
	mount -o "subvol=@home,$BTRFS_OPTS" "$ROOT" "$T/home"
	mount -o "subvol=@log,$BTRFS_OPTS" "$ROOT" "$T/var/log"
	mount -o "subvol=@snapshots,$BTRFS_OPTS" "$ROOT" "$T/.snapshots"
	mount "$EFI" "$T/boot/efi"

	echo "==> 2. The system, copied from the stick (about $(du -sh --apparent-size "$SRC" 2>/dev/null | cut -f1))"
	rsync -aHAX --numeric-ids --info=progress2 --exclude=/lost+found --exclude=/.snapshots \
		"$SRC/" "$T/" | tr '\r' '\n' | { grep --line-buffered -E '[0-9]+%' || true; } | awk 'NR % 20 == 1 { print "   " $0; fflush() }'
	sync

	echo "==> 3. Your settings"
	for x in dev dev/pts proc sys run sys/firmware/efi/efivars; do
		[ -d "/$x" ] || continue; mkdir -p "$T/$x"; mountpoint -q "$T/$x" || mount --bind "/$x" "$T/$x"
	done
	# fstab: / gets its subvolume from the kernel (rootflags), so a snapshot can start from GRUB
	{
		echo "# /etc/fstab: written by avalon-install"
		echo "UUID=$(uuid "$ROOT")  /           btrfs  $BTRFS_OPTS                  0 0"
		echo "UUID=$(uuid "$ROOT")  /home       btrfs  $BTRFS_OPTS,subvol=@home     0 0"
		echo "UUID=$(uuid "$ROOT")  /var/log    btrfs  $BTRFS_OPTS,subvol=@log      0 0"
		echo "UUID=$(uuid "$ROOT")  /.snapshots btrfs  $BTRFS_OPTS,subvol=@snapshots 0 0"
		echo "UUID=$(uuid "$EFI")   /boot/efi   vfat   umask=0077                    0 2"
		echo "devpts  /dev/pts  devpts  gid=5,mode=620  0 0"
		echo "proc    /proc     proc    defaults        0 0"
		echo "tmpfs   /dev/shm  tmpfs   nosuid,nodev    0 0"
	} > "$T/etc/fstab"
	cat "$T/etc/fstab"
	cp "$T/usr/share/avalon/os-release" "$T/etc/os-release"   # Avalon (ID_LIKE=slackware); /etc/slackware-version stays
	echo "avalon.localdomain" > "$T/etc/HOSTNAME"
	printf '127.0.0.1 localhost\n127.0.1.1 avalon.localdomain avalon\n::1 localhost\n' > "$T/etc/hosts"
	ln -sf /usr/share/zoneinfo/Europe/London "$T/etc/localtime"
	printf '# The hardware clock keeps UTC (avalon-install)\nUTC\n' > "$T/etc/hardwareclock"
	# British English, a British keyboard on the console (and the large console font)
	if grep -q '^export LANG=' "$T/etc/profile.d/lang.sh" 2>/dev/null; then
		sed -i 's|^export LANG=.*|export LANG=en_GB.UTF-8|' "$T/etc/profile.d/lang.sh"
	else
		echo 'export LANG=en_GB.UTF-8' >> "$T/etc/profile.d/lang.sh"
	fi
	printf '#!/bin/sh\n/usr/bin/loadkeys uk.map\n/usr/bin/setfont latarcyrheb-sun32 2>/dev/null\n' > "$T/etc/rc.d/rc.keymap"
	chmod 755 "$T/etc/rc.d/rc.keymap"
	# you (in the groups for sound, video, the network and sudo), root, and greetd's greeter
	inroot sh -c 'getent group greeter >/dev/null || groupadd -g 381 greeter
	              getent passwd greeter >/dev/null || useradd -d /var/lib/greeter -u 381 -g greeter -G video -s /bin/false greeter
	              mkdir -p /var/lib/greeter && chown greeter:greeter /var/lib/greeter'
	inroot useradd -m -g users -G wheel,audio,video,input,plugdev,power,netdev,lp,cdrom,scanner -s /bin/bash "$USER_NAME"
	printf '%s:%s\nroot:%s\n' "$USER_NAME" "$USER_PW" "$ROOT_PW" | inroot chpasswd
	echo "passwords: $USER_NAME and root set (hashed, in /etc/shadow)"
	[ -d "$T/etc/skel" ] && inroot sh -c "cp -rn /etc/skel/. /home/$USER_NAME/ && chown -R $USER_NAME:users /home/$USER_NAME"
	printf '# Avalon: the wheel group (you) may use sudo\n%%wheel ALL=(ALL:ALL) ALL\n' > "$T/etc/sudoers.d/wheel"
	chmod 440 "$T/etc/sudoers.d/wheel"
	# the Garden's login screen at boot: runlevel 4 runs rc.4.local, which starts greetd
	sed -i 's/^id:[0-9]:initdefault:/id:4:initdefault:/' "$T/etc/inittab"
	grep -q '^id:4:initdefault:' "$T/etc/inittab" || { echo "couldn't set runlevel 4 in /etc/inittab"; return 1; }
	[ -x "$T/etc/rc.d/rc.4.local" ] && [ -x "$T/usr/bin/greetd" ] ||
		{ echo "greetd or rc.4.local is missing: there'd be no login screen"; return 1; }
	grep -q 'greeter.qml' "$T/etc/greetd/avalon.toml" ||
		{ echo "/etc/greetd/avalon.toml doesn't start the Garden's login screen"; return 1; }
	# the services: NetworkManager (Wi-Fi), Bluetooth, elogind (seats), Avalon's own at boot
	for s in networkmanager bluetooth elogind messagebus; do
		[ -f "$T/etc/rc.d/rc.$s" ] && chmod 755 "$T/etc/rc.d/rc.$s"
	done
	[ -f "$T/etc/rc.d/rc.inet1" ] && chmod 644 "$T/etc/rc.d/rc.inet1"   # NetworkManager runs the network
	grep -q rc.avalon "$T/etc/rc.d/rc.local" 2>/dev/null ||
		printf '\n# Avalon: its own settings at boot\n[ -x /etc/rc.d/rc.avalon ] && /etc/rc.d/rc.avalon\n' >> "$T/etc/rc.d/rc.local"

	# GRUB, with Avalon's boot menu. Slackware's kernel has NVMe and Btrfs built in, so there's no
	# initrd: the root is named by its PARTUUID and its subvolume by rootflags.
	local g=$T/etc/default/grub
	set_grub() { if grep -q "^#\?$1=" "$g"; then sed -i "s|^#\?$1=.*|$1=$2|" "$g"; else echo "$1=$2" >> "$g"; fi; }
	set_grub GRUB_CMDLINE_LINUX_DEFAULT '"quiet"'
	set_grub GRUB_CMDLINE_LINUX '"rootfstype=btrfs rootflags=subvol=@ rootwait"'
	set_grub GRUB_DISABLE_LINUX_UUID true
	set_grub GRUB_DISABLE_LINUX_PARTUUID false
	set_grub GRUB_DISTRIBUTOR Avalon
	set_grub GRUB_TIMEOUT 5
	set_grub GRUB_GFXMODE auto
	set_grub GRUB_TERMINAL_OUTPUT gfxterm
	set_grub GRUB_THEME /boot/grub/themes/avalon/theme.txt
	mkdir -p "$T/boot/grub/themes"
	rm -rf "$T/boot/grub/themes/avalon"; cp -a "$T/usr/share/avalon/grub-theme" "$T/boot/grub/themes/avalon"
	inroot grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Avalon --recheck
	inroot grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable
	inroot grub-mkconfig -o /boot/grub/grub.cfg
	grep -q "root=PARTUUID=$(partuuid "$ROOT")" "$T/boot/grub/grub.cfg" ||
		{ echo "GRUB's menu doesn't name the root by PARTUUID: the laptop wouldn't find it"; return 1; }
	grep -q "rootflags=subvol=@" "$T/boot/grub/grub.cfg" ||
		{ echo "GRUB's menu doesn't give the root's subvolume"; return 1; }
	# a first snapshot: Avalon exactly as installed ("Avalon as it was" in the boot menu)
	inroot /usr/sbin/avalon-snapshot take "as installed" || echo "(no first snapshot; carrying on)"
	cp "$LOG" "$T/var/log/avalon-install.log" 2>/dev/null || true
	echo "==> Done"
}

cleanup() {
	sync
	for x in sys/firmware/efi/efivars run sys proc dev/pts dev boot/efi .snapshots var/log home; do umount -l "$T/$x" 2>/dev/null; done
	umount -l "$T" 2>/dev/null
	true
}

while :; do
	rc=/tmp/avalon-install.rc
	( steps; echo $? > $rc ) 2>&1 | tee -a "$LOG" | dialog --backtitle "$TITLE" --title " Installing Avalon " --progressbox 30 110
	[ "$(cat $rc 2>/dev/null)" = 0 ] && break
	cleanup
	choice=$(d --title " It stopped " --menu "\n\Z1Installing stopped.\Zn The last lines:\n\n$(tail -6 "$LOG" | cut -c1-100)\n" 22 110 3 \
		again "start again from the disk step" log "read the whole log" shell "a shell (type exit to come back)") ||
		quit "Stopped. The log: $LOG"
	case $choice in
		log) dialog --backtitle "$TITLE" --textbox "$LOG" 40 120 ;;
		shell) clear; echo "The log: $LOG.  Type exit to come back."; bash ;;
	esac
done
cleanup
USER_PW=; ROOT_PW=
if d --title " Avalon is installed " --yes-label "Restart now" --no-label "Not yet" --yesno "\n\
\Z2Avalon is on the disk.\Zn\n\n\
Take the USB stick out when the screen goes dark. Avalon starts at the Garden's login screen:\n\
log in as $USER_NAME.\n\n\
In the Garden: Super+; is Command Mode (\"wifi\" connects to Wi-Fi), Super+/ shows the keys." 16 76; then
	reboot
fi
clear
